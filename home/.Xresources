! Wallust generated colors
! theme: toxic-magician

! special
*.foreground:   #f6fdd9
*.background:   #212121
*.cursorColor:  #f6fdd9

! black
*.color0:       #484641
*.color8:       #a3ab87

! red
*.color1:       #b95f50
*.color9:       #f67e6a

! green
*.color2:       #40885f
*.color10:      #51ad79

! yellow
*.color3:       #4a4e77
*.color11:      #686ea7

! blue
*.color4:       #2a8ab6
*.color12:      #39baf5

! magenta
*.color5:       #5e49b1
*.color13:      #8567fa

! cyan
*.color6:       #72b8bc
*.color14:      #9afdfd

! white
*.color7:       #a2a885
*.color15:      #eaf4c1

! Fixed settings
Xcursor.theme: Apple-cursors
Xcursor.size: 20
