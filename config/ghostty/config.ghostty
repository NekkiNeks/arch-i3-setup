
# ==========================================
# GHOSTTY "ONLY TERMINAL" CONFIG
# ==========================================

theme = "default"

# --- Полное удаление интерфейса ---
# Убирает системные рамки окна, кнопки «свернуть/закрыть» и заголовки
window-decoration = false

# Скрывает панель вкладок (табов) навсегда, даже если открыто несколько
window-padding-color = "background"
# (Примечание: табы будут создаваться в фоне, но сама панель не появится)

# --- Настройка отступов ---
# Чтобы текст не прилипал к краям экрана без рамок, 
# сделаем небольшие аккуратные внутренние отступы (в пикселях)
window-padding-x = 10
window-padding-y = 10

# --- Шрифт и курсор (базовые рабочие настройки) ---
font-family = "Terminus"
font-size = 14.0
cursor-style = "block"

confirm-close-surface = false

